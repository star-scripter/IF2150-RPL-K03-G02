# --- Compose mode ---
# Default (unset): development — compose.yaml + compose.override.yaml
#   (next dev, hot reload, Postgres exposed on localhost)
# Production: uncomment the line below to use only compose.yaml
#   (standalone build, no source mount, Postgres not exposed)
# COMPOSE_FILE=compose.yaml

APP_PORT=3000
# Host port for Postgres in development (only used by compose.override.yaml)
DB_HOST_PORT=5432

POSTGRES_USER=soclean_user
POSTGRES_PASSWORD=s0Clean2026!
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=soclean_dev

# --- Session (cookie JWT, see contract "Konvensi > Auth") ---
# Development value below is fine locally. For production, generate a new one:
#   openssl rand -base64 32
SESSION_SECRET=dev-only-0123456789abcdef

# --- Object storage (S3 API) ---
# Development: RustFS container from compose.override.yaml (values below work as-is).
# Production (Cloudflare R2):
#   S3_ENDPOINT=S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto, S3_FORCE_PATH_STYLE=false, keys from an R2 API token
# S3_ENDPOINT is used by the server (inside Docker); S3_PUBLIC_ENDPOINT is the
# host put into presigned URLs, so it must be reachable from the browser.
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=soclean-media
S3_ACCESS_KEY_ID=soclean_dev
S3_SECRET_ACCESS_KEY=soclean_dev_secret
S3_FORCE_PATH_STYLE=true
# Host ports for RustFS in development (only used by compose.override.yaml)
RUSTFS_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
